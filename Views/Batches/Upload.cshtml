@model MdmBilling.ViewModels.UploadBatchViewModel

@{
    ViewData["Title"] = "Upload batch";
}

<h2>Upload batch</h2>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in Model.Errors.Take(50))
            {
                <li>@error</li>
            }
        </ul>

        @if (Model.Errors.Count > 50)
        {
            <div>
                And @(Model.Errors.Count - 50) more.
            </div>
        }
    </div>
}

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning">
        <ul class="mb-0">
            @foreach (var warning in Model.Warnings.Take(20))
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="col-md-6">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="BatchNumber" class="form-label"></label>

        <input asp-for="BatchNumber" class="form-control" type="text" inputmode="numeric" pattern="[1-9][0-9]*"
               placeholder="Enter batch number (1, 2, 3...)" />

        <span asp-validation-for="BatchNumber" class="text-danger"></span>

        <small class="text-muted">
            Enter digits only. For example: 1, 2, 3, 4.
        </small>
    </div>

    <div class="mb-3">
        <label asp-for="BillingDate" class="form-label"></label>

        <input asp-for="BillingDate" type="date" class="form-control" />

        <span asp-validation-for="BillingDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Servers to check</label>
        <div class="form-text mb-2">Select the servers that hold the meters of this batch. Only these servers are
            contacted.</div>

            @if (Model.Servers.Count == 0)
            {
                <div class="alert alert-warning">There are no active servers. Add a server first.</div>
            }
            else
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="allServers" />
                    <label class="form-check-label fw-semibold" for="allServers">Select all</label>
                </div>
                <div class="row">
                    @foreach (var s in Model.Servers)
                    {
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input srv" type="checkbox" name="SelectedServerIds" value="@s.Id"
                                       id="srv@(s.Id)" @(Model.SelectedServerIds.Contains(s.Id) ? "checked" : "") />
                                <label class="form-check-label" for="srv@(s.Id)">@s.Name <span
                                    class="text-muted">(@s.IpAddress)</span></label>
                                </div>
                            </div>
                        }
                    </div>
                }
                <span asp-validation-for="SelectedServerIds" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>

                <input asp-for="File" type="file" accept=".xlsx" class="form-control" />

                <span asp-validation-for="File" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Upload and validate
            </button>

            <a asp-action="Index" class="btn btn-link">
                Cancel
            </a>
        </form>
        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
            <script>
                const all = document.getElementById('allServers');
                if (all) all.addEventListener('change', () =>
                    document.querySelectorAll('.srv').forEach(c => c.checked = all.checked));
            </script>
        }