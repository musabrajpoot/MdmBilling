@model MdmBilling.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Bare"] = true;   // tells _Layout to hide the sidebar and top bar
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-center">
    <div class="auth-card">
        <div class="auth-logo"><i>&#9889;</i> MDM Monitor</div>

        <div class="auth-eyebrow">Security</div>
        <h2>Change password</h2>
        <p class="auth-sub">Choose a new password to continue. Use at least 10 characters, with upper and lower case letters, a number and a symbol.</p>

        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="All" class="auth-error"></div>

            <label asp-for="CurrentPassword" class="auth-label"></label>
            <input asp-for="CurrentPassword" class="auth-field" autocomplete="current-password" autofocus />

            <label asp-for="NewPassword" class="auth-label"></label>
            <input asp-for="NewPassword" class="auth-field" autocomplete="new-password" />

            <label asp-for="ConfirmPassword" class="auth-label"></label>
            <input asp-for="ConfirmPassword" class="auth-field" autocomplete="new-password" />

            <button type="submit" class="auth-btn" style="margin-top:22px">Save password</button>
        </form>

        <form asp-controller="Account" asp-action="Logout" method="post" class="auth-signout">
            <button type="submit">Sign out</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
