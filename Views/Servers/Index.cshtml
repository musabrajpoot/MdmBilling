@model List<MdmBilling.Models.Server>

@{
    ViewData["Title"] = "Servers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Servers</h2>

    <a class="btn btn-primary" asp-action="Create">
        Add server
    </a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">
        @ok
    </div>
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">
        @err
    </div>
}

<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Group</th>
                <th>Name</th>
                <th>IP Address</th>
                <th>Database</th>
                <th>Active</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var server in Model)
            {
                <tr>
                    <td>@server.Group?.Name</td>

                    <td>@server.Name</td>

                    <td>@server.IpAddress</td>

                    <td>@(server.Connections.FirstOrDefault()?.DatabaseName)</td>
                    <td>
                        @if (server.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@server.Id">
                            Edit
                        </a>

                        <form asp-action="Test" asp-route-id="@server.Id" method="post" class="d-inline">

                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                Test connection
                            </button>
                        </form>

                        <form asp-action="SetActive" asp-route-id="@server.Id" asp-route-active="@(!server.IsActive)"
                              method="post" class="d-inline">

                            <button type="submit" class="btn btn-sm @(server.IsActive
                                        ? "btn-outline-danger"
                                        : "btn-outline-success")">

                                @(server.IsActive
                                    ? "Deactivate"
                                    : "Activate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
