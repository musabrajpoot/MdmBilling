@model List<MdmBilling.ViewModels.UserListItem>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Users</h2>
        <p class="text-muted mb-0">Manage application users and permissions.</p>
    </div>

    <a class="btn btn-primary" asp-controller="Users" asp-action="Create">
        <i class="bi bi-person-plus me-1"></i> Add User
    </a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">
        @ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" asp-controller="Users" asp-action="Index" class="row g-2 mb-3">

    <div class="col-md-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or email" />
    </div>

    <div class="col-md-3">
        <select name="role" asp-items="(SelectList)ViewBag.Roles" class="form-select">
            <option value="">All roles</option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-search me-1"></i> Filter
        </button>
    </div>

    <div class="col-auto">
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>

</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Reports</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No users found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>

                            <td>@u.Email</td>

                            <td>@u.Role</td>

                            <td>
                                @if (!u.IsActive)
                                {
                                    <span class="badge bg-danger">Deactivated</span>
                                }
                                else if (u.IsLocked)
                                {
                                    <span class="badge bg-warning text-dark">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>

                            <td>
                                @(u.CanDownloadReports ? "Yes" : "No")
                            </td>

                            <td>
                                @(u.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")
                            </td>

                            <td class="text-end text-nowrap">

                                <!-- EDIT USER -->
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Edit", "Users", new { id = u.Id })">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <!-- ACTIVATE / DEACTIVATE -->
                                @if (u.IsActive)
                                {
                                    <form asp-controller="Users" asp-action="Deactivate" asp-route-id="@u.Id" method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Deactivate this user?');">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Users" asp-action="Activate" asp-route-id="@u.Id" method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    </form>
                                }

                                <!-- RESET PASSWORD -->
                                <form asp-controller="Users" asp-action="ResetPassword" asp-route-id="@u.Id" method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            onclick="return confirm('Reset this user password?');">
                                        Reset Password
                                    </button>
                                </form>

                                <!-- UNLOCK -->
                                @if (u.IsLocked)
                                {
                                    <form asp-controller="Users" asp-action="Unlock" asp-route-id="@u.Id" method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            Unlock
                                        </button>
                                    </form>
                                }

                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>
