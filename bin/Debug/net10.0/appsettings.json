{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Server=(localdb)\\MSSQLLocalDB;Database=MdmBillingApp;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "DataProtection": {
    "KeysPath": "C:/MdmBillingKeys"
  },
  "Storage": {
    "Root": "C:/MdmBillingData"
  },
  "Processing": {
    "MaxParallelServers": 3,
    "ChunkSize": 500,
    "MaxRetries": 2,
    "RetryDelaySeconds": 5
  },
  "Udil": {
    "UseFake": false,
    "ConnectTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 60,
    "Encrypt": true,
    "TrustServerCertificate": false
  },
  "Email": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 465,
    "Security": "SslOnConnect",
    "Username": "musabbinnadeem9@gmail.com",
    "Password": "Musabbinnadeem!123",
    "FromAddress": "musabbinnadeem9@gmail.com",
    "FromName": "MDM Billing Monitor"
  },
  "Dashboard": { "HealthCacheSeconds": 30 }
}
